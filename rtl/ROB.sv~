    // 单周期写入计数 - 无恢复触发、非满时，按写入使能计数（0/1/2）
    always_comb begin
        write_cnt = 2'b00;
        if (!recover_en && !rob_full) begin
            if (rob_wr_en_1 && rob_wr_en_2) write_cnt = 2'b10;
            else if (rob_wr_en_1 && (!rob_wr_en_2)) write_cnt = 2'b01;
        end
    end

    // 退休逻辑 - 头指针开始2条都完成则一起退休，否则仅头指针1条（若完成）
    always_comb begin
        retire_en_1 = 1'b0;
        retire_en_2 = 1'b0;
        retire_rd_old_1 = '0;
        retire_rd_en_1  = '0;
        retire_memwrite_1 = '0;
        retire_rd_old_2 = '0;
        retire_rd_en_2  = '0;
        retire_memwrite_2 = '0;
        retire_cnt      = 2'b00;

        // 非恢复触发、非空时执行退休判断
        if (!recover_en && !rob_empty) begin
            // 第一条退休：头指针条目有效且完成
            if (rob_array[head_ptr[ROB_IDX_WID-1:0]].valid && 
                rob_array[head_ptr[ROB_IDX_WID-1:0]].complete &&
                    head_ptr != tail_ptr) begin
                retire_en_1      = 1'b1;
                retire_rd_old_1  = rob_array[head_ptr[ROB_IDX_WID-1:0]].rd_old;
                retire_rd_en_1   = rob_array[head_ptr[ROB_IDX_WID-1:0]].rd_en;
                retire_memwrite_1= rob_array[head_ptr[ROB_IDX_WID-1:0]].memwrite;
                retire_cnt       = 2'b01;
		//retire_memwrite_cnt = '0;

                // 第二条退休：头+1条目有效且完成（2条都完成则一起退休）
                if (rob_array[head_ptr_plus1[ROB_IDX_WID-1:0]].valid && 
                    rob_array[head_ptr_plus1[ROB_IDX_WID-1:0]].complete &&
                    head_ptr_plus1 != tail_ptr) begin
                    retire_en_2      = 1'b1;
                    retire_rd_old_2  = rob_array[head_ptr_plus1[ROB_IDX_WID-1:0]].rd_old;
                    retire_rd_en_2   = rob_array[head_ptr_plus1[ROB_IDX_WID-1:0]].rd_en;
                    retire_memwrite_2= rob_array[head_ptr_plus1[ROB_IDX_WID-1:0]].memwrite; 
                    retire_cnt       = 2'b10;
                end
            end
            // memwrite计数逻辑：与/异或判断
            if (retire_memwrite_1 & retire_memwrite_2) begin    
                retire_memwrite_cnt = 2'b11; //这里的11不代表有3条指令要写存储器，只有两条，写成11是由于SDB要求
            end else if (retire_memwrite_1 ^ retire_memwrite_2) begin
                retire_memwrite_cnt = 2'b01;
            end else begin
                retire_memwrite_cnt = 2'b00;
            end
        end
    end

    // ============ 恢复输出逻辑 -WALK方式，每次从队尾恢复2条，直到恢复到错误ROB ID ============
    always_comb begin
        recover_valid_1    = 1'b0;
        recover_valid_2    = 1'b0;
        recover_rd_en_1    = 1'b0;
        recover_rd_logic_1 = '0;
        recover_rd_old_1   = '0;
        recover_rd_new_1   = '0;
        recover_rd_en_2    = 1'b0;
        recover_rd_logic_2 = '0;
        recover_rd_old_2   = '0;
        recover_rd_new_2   = '0;
        recover_complete   = 1'b0;
        recover_step       = 2'b00;

        // 恢复触发时执行恢复逻辑
        if (recover_en && recover_init_done) begin
            // 第一条恢复：当前恢复指针条目有效
            if (rob_array[recover_ptr[ROB_IDX_WID-1:0]].valid) begin
                recover_valid_1    = 1'b1;
                recover_rd_en_1    = rob_array[recover_ptr[ROB_IDX_WID-1:0]].rd_en;
                recover_rd_logic_1 = rob_array[recover_ptr[ROB_IDX_WID-1:0]].rd_logic;
                recover_rd_old_1   = rob_array[recover_ptr[ROB_IDX_WID-1:0]].rd_old;
                recover_rd_new_1   = rob_array[recover_ptr[ROB_IDX_WID-1:0]].rd_new;
                recover_step       = 2'b01;

                // 检查是否到达恢复终点：当前指针=错误ROB ID → 恢复完成
                if (recover_ptr == recover_id) begin
                    recover_complete = 1'b1;
                    recover_step     = 2'b00; // 无需更新指针
                end else begin
                    // 第二条恢复：恢复指针-1条目有效（每次恢复2条）
                    logic [ROB_ID_WID-1:0] recover_ptr_minus1;
                    // 直接7位无符号减法，自然回绕
                    recover_ptr_minus1 = recover_ptr - 1'b1;

                    // 第二条指令是目标ID时的逻辑
                    if (recover_ptr_minus1 == recover_id) begin
                        // 第二条指令就是目标ID：仅恢复该指令，标记完成，指针不移动
                        if (rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].valid) begin
                            recover_valid_2    = 1'b1;
                            recover_rd_en_2    = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_en;
                            recover_rd_logic_2 = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_logic;
                            recover_rd_old_2   = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_old;
                            recover_rd_new_2   = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_new;
                        end
                        recover_complete = 1'b1; // 恢复完成
                        recover_step     = 2'b00; // 指针不移动
                    end else if (rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].valid) begin
                        // 第二条指令不是目标ID：正常恢复，指针减2
                        recover_valid_2    = 1'b1;
                        recover_rd_en_2    = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_en;
                        recover_rd_logic_2 = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_logic;
                        recover_rd_old_2   = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_old;
                        recover_rd_new_2   = rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]].rd_new;
                        recover_step       = 2'b10;
                    end
                end
            end else begin
                // 当前指针条目无效 → 恢复完成
                recover_complete = 1'b1;
            end
        end
    end

    // ========================================================
    // 时序逻辑部分 写入/退休/恢复/完成更新规则
    // ========================================================
    always_ff @(posedge clk) begin
        if (reset) begin
            // 复位：指针清0，ROB阵列全部无效
            head_ptr          <= '0;
            tail_ptr          <= '0;
            recover_init_done <= 1'b0;
            recover_ptr       <= '0;
            for (int i = 0; i < ROB_ENTRY_NUM; i++) begin
                rob_array[i].valid    <= 1'b0;
                rob_array[i].rd_en    <= 1'b0;
                rob_array[i].rd_new   <= '0;
                rob_array[i].rd_old   <= '0;
                rob_array[i].rd_logic <= '0;
                rob_array[i].memwrite <= 1'b0;
                rob_array[i].complete <= 1'b0; 
            end
        end else begin
            // ============ 1. 分支恢复触发与执行 ============
            if (recover_en) begin
                // 触发恢复：恢复指针未初始化时置为尾指针-1
                if (!recover_init_done) begin
                    recover_ptr        <= tail_ptr_minus1;
                    recover_init_done  <= 1'b1;
                end 
                // 恢复完成处理
                else if (recover_complete) begin
                    // 恢复完成：更新尾指针到recover_id+1
                    tail_ptr <= recover_id + 1'b1;
                    recover_init_done <= 1'b0;
                    recover_ptr       <= '0;
                end 
                // 未完成时移动恢复指针
                else begin 
                    case (recover_step)
                        2'b10:  recover_ptr <= recover_ptr - 2'd2;
                        2'b01:  recover_ptr <= recover_ptr - 1'b1;
                        default: ;
                    endcase
                end
            end else begin
                // 无恢复触发时：清零恢复相关状态
                recover_ptr       <= '0;
                recover_init_done <= 1'b0;
            end
            
            // ============ 2. ROB写入逻辑 ============
            // 写入操作：只有在非恢复且非满时才允许写入
            if (!recover_en && !rob_full) begin 
                if (rob_wr_en_1) begin
                    // 写入指令1
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].valid    <= 1'b1;
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].rd_en    <= rob_rd_en_1;
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].rd_new   <= rob_rd_new_1;
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].rd_old   <= rob_rd_old_1;
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].rd_logic <= rob_rd_logic_1;
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].memwrite <= rob_memwrite_1;
                    rob_array[tail_ptr[ROB_IDX_WID-1:0]].complete <= 1'b0;

                    // 如果指令2也有效，写入指令2
                    if (rob_wr_en_2) begin
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].valid    <= 1'b1;
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].rd_en    <= rob_rd_en_2;
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].rd_new   <= rob_rd_new_2;
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].rd_old   <= rob_rd_old_2;
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].rd_logic <= rob_rd_logic_2;
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].memwrite <= rob_memwrite_2;
                        rob_array[tail_ptr_plus1[ROB_IDX_WID-1:0]].complete <= 1'b0;        
                    end
                end
            end

            // ============ 3. 尾指针更新 - 关键修复 ============
            // 只有在非恢复且非满时才更新尾指针
            if (!recover_en && !rob_full) begin
                if (rob_wr_en_1 && rob_wr_en_2) begin
                    tail_ptr <= tail_ptr + 2'd2;
                end else if (rob_wr_en_1) begin
                    tail_ptr <= tail_ptr + 1'b1;
                end
            end
            // 恢复期间或ROB满时，tail_ptr保持不变

            // ============ 4. 头指针更新 ============
            // 头指针更新：只有在非恢复时才更新
            if (!recover_en) begin
                if (retire_en_1 && retire_en_2) begin
                    head_ptr <= head_ptr + 2'd2;
                end else if (retire_en_1) begin
                    head_ptr <= head_ptr + 1'b1;
                end
            end

            // ============ 5. 执行完成标志更新 ============
            // 完成标志：只有在非恢复时才更新
            if (!recover_en) begin
                if (complete_en_alu && rob_array[complete_id_alu[ROB_IDX_WID-1:0]].valid)    
                    rob_array[complete_id_alu[ROB_IDX_WID-1:0]].complete <= 1'b1;
                if (complete_en_bru && rob_array[complete_id_bru[ROB_IDX_WID-1:0]].valid)    
                    rob_array[complete_id_bru[ROB_IDX_WID-1:0]].complete <= 1'b1;
                if (complete_en_lsu_load && rob_array[complete_id_lsu_load[ROB_IDX_WID-1:0]].valid)    
                    rob_array[complete_id_lsu_load[ROB_IDX_WID-1:0]].complete <= 1'b1;
                if (complete_en_lsu_store && rob_array[complete_id_lsu_store[ROB_IDX_WID-1:0]].valid)    
                    rob_array[complete_id_lsu_store[ROB_IDX_WID-1:0]].complete <= 1'b1;
                if (complete_en_mdu_mul && rob_array[complete_id_mdu_mul[ROB_IDX_WID-1:0]].valid)
                    rob_array[complete_id_mdu_mul[ROB_IDX_WID-1:0]].complete <= 1'b1;
                if (complete_en_mdu_div && rob_array[complete_id_mdu_div[ROB_IDX_WID-1:0]].valid)
                    rob_array[complete_id_mdu_div[ROB_IDX_WID-1:0]].complete <= 1'b1;
            end

            // ============ 6. 退休条目清除 ============
            // 清除退休条目：只有在非恢复时才执行
            if (!recover_en) begin
                if (retire_en_1) begin
                    rob_array[head_ptr[ROB_IDX_WID-1:0]] <= '0;
                    if (retire_en_2) begin
                        rob_array[head_ptr_plus1[ROB_IDX_WID-1:0]] <= '0;
                    end
                end
            end

            // ============ 7. 恢复条目清除 ============
            // 清除恢复的条目：只有在恢复期间且未完成时才执行
            if (recover_en && !recover_complete) begin
                logic [ROB_ID_WID-1:0] recover_ptr_minus1;  // 临时变量
                
                if (recover_valid_1) begin
                    rob_array[recover_ptr[ROB_IDX_WID-1:0]] <= '0;
                end
                if (recover_valid_2) begin
                    recover_ptr_minus1 = recover_ptr - 1'b1;
                    rob_array[recover_ptr_minus1[ROB_IDX_WID-1:0]] <= '0;
                end
            end
        end
    end

endmodule
