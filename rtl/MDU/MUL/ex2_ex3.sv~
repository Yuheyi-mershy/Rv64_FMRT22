module ex2_ex3(
    input  logic        clk,
    input  logic        reset,
    input  logic [3:0]  mdu_control_ex2,         // MDU控制信号
    input  logic        reg_write_ex2,           // 寄存器写使能
    input  logic [5:0]  rd_number_ex2,           // RD寄存器编号
    input  logic [7:0][127:0] product_ex2,       // 8个部分积
    input  logic [2:0][127:0] product_32_33_34_ex2, // 第32-34个部分积
    input  logic        bru_recovery,            // 分支恢复信号
    input  logic [6:0]  bru_rob_id,              // 分支ROB ID
    input  logic [6:0]  rob_id_ex2,              // 当前指令ROB ID
    input  logic        instr_valid_ex2,         // 指令有效信号
    output logic [5:0]  rd_number_ex3,           // EX3阶段RD编号
    output logic [6:0]  rob_id_ex3,              // EX3阶段ROB ID
    output logic        reg_write_ex3,           // EX3阶段寄存器写使能
    output logic [3:0]  mdu_control_ex3,         // EX3阶段MDU控制
    output logic        instr_valid_ex3,         // EX3阶段指令有效
    output logic [7:0][127:0] product_ex3,       // EX3阶段部分积
    output logic [2:0][127:0] product_32_33_34_ex3 // EX3阶段第32-34部分积
);   
     
    // 定义冲突处理信号
    logic flush, stall;
    
    // 分支恢复检测模块实例化 - 修正端口连接
    brurecovery bru_re(
        .bru_recovery(bru_recovery),
        .bru_rob_id(bru_rob_id),
        .rob_id(rob_id_ex2),    
        .flush(flush),
        .stall(stall)
    );
    
    // 流水线寄存器：EX2 -> EX3
    always_ff @(posedge clk) begin
        if (reset || flush || mdu_control_ex2[3]) begin
            // 复位或冲刷或乘法取消时清零
            rd_number_ex3   <= 6'd0;
            rob_id_ex3      <= 7'd0;
            reg_write_ex3   <= 1'd0;
            mdu_control_ex3 <= 4'd0;
            instr_valid_ex3 <= 1'd0;
            // 清零8个部分积
            for (int i = 0; i < 8; i++) begin
                product_ex3[i] <= 128'd0;
            end
            
            // 清零第32-34个部分积
            for (int i = 0; i < 3; i++) begin
                product_32_33_34_ex3[i] <= 128'd0;
            end
        end
        else if (~stall) begin
            // 非阻塞时传递信号 - 修正所有信号名
            rd_number_ex3   <= rd_number_ex2;           // 使用ex2阶段信号
            rob_id_ex3      <= rob_id_ex2;              // 使用ex2阶段信号
            reg_write_ex3   <= reg_write_ex2;           // 使用ex2阶段信号
            mdu_control_ex3 <= mdu_control_ex2;         // 使用ex2阶段信号
            instr_valid_ex3 <= instr_valid_ex2;         // 使用ex2阶段信号
            // 传递8个部分积
            for (int i = 0; i < 8; i++) begin
                product_ex3[i] <= product_ex2[i];
            end
            
            // 传递第32-34个部分积
            for (int i = 0; i < 3; i++) begin
                product_32_33_34_ex3[i] <= product_32_33_34_ex2[i];
            end
        end
        // stall时保持原有值
    end
    
endmodule
