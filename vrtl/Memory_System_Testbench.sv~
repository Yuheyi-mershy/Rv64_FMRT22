module Memory_System_Testbench;
    // 时钟和复位
    logic clk;
    logic reset;
    
    // 处理器接口 - 指令侧
    logic [38:0] I_VA;
    logic IT_req_in;
    logic IC_dataout_rdy;
    logic I_hit;
    logic [127:0] I_data_out;
    logic [11:0] Br_type_out;
    logic IC_dataout_val;
    
    // 处理器接口 - 数据侧
    logic [38:0] D_VA;
    logic [63:0] St_data;
    logic [1:0] St_type;
    logic Ld_en;
    logic St_en;
    logic DC_dataout_rdy;
    logic D_hit;
    logic [63:0] D_data_out;
    logic DC_dataout_val;
    
    // 外部控制信号
    logic pause_signal;
    
    // 内部状态监控信号
    logic [31:0] IT_PA_monitor;
    logic IT_hit_monitor;
    logic IT_req_monitor;
    logic [38:0] IT_miss_va_monitor;
    logic IC_req_monitor;
    logic [31:0] IC_addr_monitor;
    logic DT_req_monitor;
    logic DC_req_monitor;
    logic DC_dirty_monitor;
    logic [31:0] DC_addr_monitor;
    logic [127:0] DC_dirty_data_monitor;
    logic mem_write_en_monitor;
    logic [31:0] mem_read_addr_monitor;
    logic [31:0] mem_write_addr_monitor;
    logic [127:0] mem_write_data_monitor;
    logic mem_data_valid_monitor;
    
    // TLB和Cache完成信号监控
    logic IT_access_done_monitor;
    logic DT_access_done_monitor;
    logic IC_done_monitor;
    logic DC_done_monitor;
    
    // 访问计数器监控
    logic [1:0] IT_access_counter_monitor;
    logic [1:0] DT_access_counter_monitor;
    logic IT_access_active_monitor;
    logic DT_access_active_monitor;
    
    // 测试控制信号
    logic test_start;
    logic [31:0] test_cycle_count;
    
    // 错误计数器
    integer error_count = 0;
    
    // 实例化待测试模块
    Memory_System uut (
        .clk(clk),
        .reset(reset),
        
        // 处理器接口 - 指令侧
        .I_VA(I_VA),
        .IT_req_in(IT_req_in),
        .IC_dataout_rdy(IC_dataout_rdy),
        .I_hit(I_hit),
        .I_data_out(I_data_out),
        .Br_type_out(Br_type_out),
        .IC_dataout_val(IC_dataout_val),
        
        // 处理器接口 - 数据侧
        .D_VA(D_VA),
        .St_data(St_data),
        .St_type(St_type),
        .Ld_en(Ld_en),
        .St_en(St_en),
        .DC_dataout_rdy(DC_dataout_rdy),
        .D_hit(D_hit),
        .D_data_out(D_data_out),
        .DC_dataout_val(DC_dataout_val),
        
        // 外部控制信号
        .pause_signal(pause_signal)
    );
    
    // 连接内部状态监控信号
    assign IT_PA_monitor = uut.IT_PA;
    assign IT_hit_monitor = uut.IT_hit;
    assign IT_req_monitor = uut.IT_req;
    assign IT_miss_va_monitor = uut.IT_miss_va;
    assign IC_req_monitor = uut.IC_req;
    assign IC_addr_monitor = uut.IC_addr;
    assign DC_req_monitor = uut.DC_req;
    assign DT_req_monitor = uut.DT_req;
    assign DC_dirty_monitor = uut.DC_dirty;
    assign DC_addr_monitor = uut.DC_addr;
    assign DC_dirty_data_monitor = uut.DC_dirty_data;
    assign mem_write_en_monitor = uut.mem_write_en;
    assign mem_read_addr_monitor = uut.mem_read_addr;
    assign mem_write_addr_monitor = uut.mem_write_addr;
    assign mem_write_data_monitor = uut.mem_write_data;
    assign mem_data_valid_monitor = uut.mem_data_valid;
    
    // 连接新增的完成信号
    assign IT_access_done_monitor = uut.IT_access_done;
    assign DT_access_done_monitor = uut.DT_access_done;
    assign IC_done_monitor = uut.IC_done;
    assign DC_done_monitor = uut.DC_done;
    
    // 连接访问计数器信号
    assign IT_access_counter_monitor = uut.IT_access_counter;
    assign DT_access_counter_monitor = uut.DT_access_counter;
    assign IT_access_active_monitor = uut.IT_access_active;
    assign DT_access_active_monitor = uut.DT_access_active;
    
    // 时钟生成
    initial begin
        clk = 0;
        forever #10 clk = ~clk;
    end
    
    // 任务：通过force初始化主存
    task force_initialize_memory;
        integer i;  // 在任务内部声明变量
        begin
            $display("[%0t] === 通过force初始化Memory_System主存 ===", $time);
            
            // 等待时钟稳定
            #10;
            
            // 使用force命令初始化主存
            // 初始化指令区域
            force uut.main_mem_inst.mem_array[256] = generate_test_instructions(0);
            force uut.main_mem_inst.mem_array[257] = generate_test_instructions(1);
            force uut.main_mem_inst.mem_array[258] = generate_test_instructions(2);
            force uut.main_mem_inst.mem_array[259] = generate_test_instructions(3);
            force uut.main_mem_inst.mem_array[260] = 128'hDEADBEEF_CAFEBABE_12345678_90ABCDEF;
            
            // 初始化更多指令区域用于不同测试用例
            force uut.main_mem_inst.mem_array[272] = generate_branch_instructions(0);
            force uut.main_mem_inst.mem_array[273] = generate_branch_instructions(1);
            force uut.main_mem_inst.mem_array[274] = generate_branch_instructions(2);
            
            $display("  指令区域初始化完成: 物理地址0x1000-0x1040 -> 数组索引256-260");
            $display("  分支指令区域初始化: 物理地址0x1100-0x1120 -> 数组索引272-274");
            
            // 初始化数据区域
            force uut.main_mem_inst.mem_array[512] = generate_test_data(0);
            force uut.main_mem_inst.mem_array[513] = generate_test_data(1);
            force uut.main_mem_inst.mem_array[514] = generate_test_data(2);
            force uut.main_mem_inst.mem_array[515] = 128'h11111111_22222222_33333333_44444444;
            
            $display("  数据区域初始化完成: 物理地址0x2000-0x2030 -> 数组索引512-515");
            
            // 初始化页表区域（关键！）
            force uut.main_mem_inst.mem_array[4096] = 128'h00001001_00002001_00003001_00008001;
            force uut.main_mem_inst.mem_array[8192] = 128'h00010003_00020003_00030003_0000c003;
            force uut.main_mem_inst.mem_array[8320] = 128'h00010003_00020003_00030003_0000c003;
            force uut.main_mem_inst.mem_array[12288] = 128'h00001007_00002007_00003007_00000407;
            
            // 初始化额外的页表项用于不同地址映射
            force uut.main_mem_inst.mem_array[4097] = 128'h00005001_00006001_00007001_00008001;
            force uut.main_mem_inst.mem_array[8256] = 128'h00050003_00060003_00070003_00010003;
            force uut.main_mem_inst.mem_array[16384] = 128'h00005007_00006007_00007007_00008007;
	    force uut.main_mem_inst.mem_array[16385] = 128'h00005007_00006007_00007007_00008007;
	    force uut.main_mem_inst.mem_array[16386] = 128'h00005007_00006007_00007007_00002007;
            
            $display("  页表区域初始化完成:");
            $display("    物理地址0x10000 -> 数组索引4096-4097");
            $display("    物理地址0x20000 -> 数组索引8192-8193");
            $display("    物理地址0x30000 -> 数组索引12288-12289");
            
            // 手动初始化Cache替换测试用的数据区域
            $display("  初始化Cache替换测试数据区域...");
            
            // 为addr1准备的数据 (物理地址0x2080 = 数组索引520)
            force uut.main_mem_inst.mem_array[520] = {64'hAAAAAAAAAAAAAAAA, 64'hBBBBBBBBBBBBBBBB};
            
            // 为addr2准备的数据 (物理地址0x2100 = 数组索引528)
            force uut.main_mem_inst.mem_array[528] = {64'hCCCCCCCCCCCCCCCC, 64'hDDDDDDDDDDDDDDDD};
            
            // 为addr3准备的数据 (物理地址0x2180 = 数组索引536)
            force uut.main_mem_inst.mem_array[536] = {64'hEEEEEEEEEEEEEEEE, 64'hFFFFFFFFFFFFFFFF};
            
            $display("  Cache测试数据初始化完成:");
            $display("    物理地址0x2080 -> 数组索引520 -> 数据: AAAAAAAA... BBBBBBBB...");
            $display("    物理地址0x2100 -> 数组索引528 -> 数据: CCCCCCCC... DDDDDDDD...");
            $display("    物理地址0x2180 -> 数组索引536 -> 数据: EEEEEEEE... FFFFFFFF...");
            
            $display("  ✓ 主存初始化完成");
        end
    endtask
    
    // 任务：释放force
    task release_memory_forces;
        integer i;  // 在任务内部声明变量
        begin
            $display("[%0t] 释放force命令...", $time);
            
            // 释放指令区域
            release uut.main_mem_inst.mem_array[256];
            release uut.main_mem_inst.mem_array[257];
            release uut.main_mem_inst.mem_array[258];
            release uut.main_mem_inst.mem_array[259];
            release uut.main_mem_inst.mem_array[260];
            release uut.main_mem_inst.mem_array[272];
            release uut.main_mem_inst.mem_array[273];
            release uut.main_mem_inst.mem_array[274];
            
            // 释放数据区域
            release uut.main_mem_inst.mem_array[512];
            release uut.main_mem_inst.mem_array[513];
            release uut.main_mem_inst.mem_array[514];
            release uut.main_mem_inst.mem_array[515];
            
            // 释放页表内容
            release uut.main_mem_inst.mem_array[4096];
            release uut.main_mem_inst.mem_array[4097];
            release uut.main_mem_inst.mem_array[8192];
            release uut.main_mem_inst.mem_array[8193];
            release uut.main_mem_inst.mem_array[12288];
            release uut.main_mem_inst.mem_array[12289];
            
            // 释放Cache测试数据
            release uut.main_mem_inst.mem_array[520];
            release uut.main_mem_inst.mem_array[528];
            release uut.main_mem_inst.mem_array[536];
            
            $display("  ✓ Force命令已释放");
        end
    endtask
    
    // 任务：显示当前状态
    task display_status;
        input string desc;
        $display("\n[%0t] === 测试步骤: %s ===", $time, desc);
        $display("周期: %0d", test_cycle_count);
        $display("指令侧: VA=%h, 命中=%b, 数据=%h, 分支类型=%b, IC_dataout_val=%b", 
                I_VA, I_hit, I_data_out, Br_type_out, IC_dataout_val);
        $display("I-TLB状态: PA=%h, 命中=%b, 请求=%b, 缺失地址=%h, 访问计数器=%b, 活跃=%b", 
                IT_PA_monitor, IT_hit_monitor, IT_req_monitor, IT_miss_va_monitor, 
                IT_access_counter_monitor, IT_access_active_monitor);
        $display("I-Cache状态: 请求=%b, 地址=%h, 完成=%b", 
                IC_req_monitor, IC_addr_monitor, IC_done_monitor);
        $display("数据侧: VA=%h, Ld_en=%b, St_en=%b, 命中=%b, 数据=%h, DC_dataout_val=%b", 
                D_VA, Ld_en, St_en, D_hit, D_data_out, DC_dataout_val);
        $display("D-Cache状态: 请求=%b, 脏=%b, 地址=%h, 脏数据=%h, 完成=%b", 
                DC_req_monitor, DC_dirty_monitor, DC_addr_monitor, DC_dirty_data_monitor, DC_done_monitor);
        $display("主存访问: 读地址=%h, 写地址=%h, 写使能=%b, 写数据=%h, 数据有效=%b", 
                mem_read_addr_monitor, mem_write_addr_monitor, mem_write_en_monitor, 
                mem_write_data_monitor, mem_data_valid_monitor);
        $display("TLB完成信号: IT_access_done=%b, DT_access_done=%b", 
                IT_access_done_monitor, DT_access_done_monitor);
    endtask
    
    // 任务：设置指令访问
    task set_instruction_access;
        input [38:0] va;
        input logic req;
        begin
            I_VA = va;
            IT_req_in = req;
            IC_dataout_rdy = 1'b1;
        end
    endtask
    
    // 任务：设置数据访问（Load）
    task set_data_load_access;
        input [38:0] va;
        begin
            D_VA = va;
            Ld_en = 1'b1;
            St_en = 1'b0;
            St_data = 64'b0;
            St_type = 2'b00;
            DC_dataout_rdy = 1'b1;
        end
    endtask
    
    // 任务：设置数据访问（Store）
    task set_data_store_access;
        input [38:0] va;
        input [63:0] data;
        input [1:0] store_type;
        begin
            D_VA = va;
            Ld_en = 1'b0;
            St_en = 1'b1;
            St_data = data;
            St_type = store_type;
            DC_dataout_rdy = 1'b1;
        end
    endtask
    
    // 任务：重置数据访问
    task reset_data_access;
        begin
            Ld_en = 1'b0;
            St_en = 1'b0;
            DC_dataout_rdy = 1'b0;
        end
    endtask
    
    // 任务：等待TLB请求
    task wait_for_tlb_request;
        input logic is_itlb;  // 1=ITLB, 0=DTLB
        integer timeout;
        begin
            timeout = 0;
            if (is_itlb) begin
                while (!IT_req_monitor && timeout < 5) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 5)
                    $display("[%0t] 警告: 等待ITLB请求超时", $time);
                else
                    $display("[%0t] ITLB请求已检测到", $time);
            end else begin
                // 等待D-TLB请求 - 注意：D-TLB请求通过DC_req_monitor监控
                while (!DT_req_monitor && timeout < 5) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 5)
                    $display("[%0t] 警告: 等待DTLB请求超时", $time);
                else
                    $display("[%0t] DTLB请求已检测到", $time);
            end
        end
    endtask
    
    // 任务：等待Cache请求
    task wait_for_cache_request;
        input logic is_icache;  // 1=ICache, 0=DCache
        integer timeout;
        begin
            timeout = 0;
            if (is_icache) begin
                while (!IC_req_monitor && timeout < 5) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 5)
                    $display("[%0t] 警告: 等待ICache请求超时", $time);
                else
                    $display("[%0t] ICache请求已检测到", $time);
            end else begin
                while (!DC_req_monitor && timeout < 5) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 5)
                    $display("[%0t] 警告: 等待DCache请求超时", $time);
                else
                    $display("[%0t] DCache请求已检测到", $time);
            end
        end
    endtask
    
    // 任务：等待TLB完成
    task wait_for_tlb_done;
        input logic is_itlb;  // 1=ITLB, 0=DTLB
        integer timeout;
        begin
            timeout = 0;
            if (is_itlb) begin
                while (!IT_access_done_monitor && timeout < 15) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 15)
                    $display("[%0t] 警告: 等待ITLB完成超时", $time);
                else
                    $display("[%0t] ITLB访问已完成", $time);
            end else begin
                while (!DT_access_done_monitor && timeout < 15) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 15)
                    $display("[%0t] 警告: 等待DTLB完成超时", $time);
                else
                    $display("[%0t] DTLB访问已完成", $time);
            end
        end
    endtask

    // 任务：清空TLB和Cache
    task clear_tlb_and_cache;
        begin
            $display("\n[%0t] === 清空TLB和Cache ===", $time);
            
            // 方法1: 使用复位信号（最可靠）
            reset = 1'b1;
	    IT_req_in = 1'b0;
            @(posedge clk);
            $display("  复位信号置位");
            
            // 保持复位至少3个周期以确保所有状态被清除
            repeat(3) @(posedge clk);
            
            reset = 1'b0;
            @(posedge clk);
            $display("  复位信号释放");
            
            // 验证清除效果
            $display("  验证清除状态:");
            $display("    IT_access_active_monitor = %b", IT_access_active_monitor);
            $display("    DT_access_active_monitor = %b", DT_access_active_monitor);
            $display("    IC_req_monitor = %b", IC_req_monitor);
            $display("    DC_req_monitor = %b", DC_req_monitor);
            
            // 等待系统稳定
            repeat(2) @(posedge clk);
            $display("  ✓ TLB和Cache已清空");
        end
    endtask

    // 任务：等待Cache完成
    task wait_for_cache_done;
        input logic is_icache;  // 1=ICache, 0=DCache
        integer timeout;
        begin
            timeout = 0;
            if (is_icache) begin
                while (!IC_done_monitor && timeout < 10) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 10)
                    $display("[%0t] 警告: 等待ICache完成超时", $time);
                else
                    $display("[%0t] ICache访问已完成", $time);
            end else begin
                while (!DC_done_monitor && timeout < 10) begin
                    @(posedge clk);
                    #1;
                    timeout = timeout + 1;
                end
                if (timeout >= 10)
                    $display("[%0t] 警告: 等待DCache完成超时", $time);
                else
                    $display("[%0t] DCache访问已完成", $time);
            end
        end
    endtask
    
    // 任务：验证取指结果
    task verify_instruction_fetch;
        input [127:0] expected_data;
        input [11:0] expected_br_type;
        begin
            if (I_hit) begin
                if (I_data_out === expected_data) begin
                    $display("✓ 取指数据正确: %h", I_data_out);
                end else begin
                    $display("✗ 取指数据错误: 期望=%h, 实际=%h", 
                            expected_data, I_data_out);
                    error_count = error_count + 1;
                end
                if (Br_type_out === expected_br_type) begin
                    $display("✓ 分支类型正确: %b", Br_type_out);
                end else begin
                    $display("✗ 分支类型错误: 期望=%b, 实际=%b", 
                            expected_br_type, Br_type_out);
                    error_count = error_count + 1;
                end
                if (IC_dataout_val) begin
                    $display("✓ IC_dataout_val有效");
                end else begin
                    $display("✗ IC_dataout_val无效");
                    error_count = error_count + 1;
                end
            end else begin
                $display("✗ 取指未命中");
                error_count = error_count + 1;
            end
        end
    endtask
    
    // 任务：验证数据加载结果
    task verify_data_load;
        input [63:0] expected_data;
        begin
            if (D_hit) begin
                if (D_data_out === expected_data) begin
                    $display("✓ 数据加载正确: %h", D_data_out);
                end else begin
                    $display("✗ 数据加载错误: 期望=%h, 实际=%h", 
                            expected_data, D_data_out);
                    error_count = error_count + 1;
                end
                if (DC_dataout_val) begin
                    $display("✓ DC_dataout_val有效");
                end else begin
                    $display("✗ DC_dataout_val无效");
                    error_count = error_count + 1;
                end
            end else begin
                $display("✗ 数据加载未命中");
                error_count = error_count + 1;
            end
        end
    endtask
    
    // 任务：验证数据存储结果
    task verify_data_store;
        begin
            // 验证Store操作是否被正确接收
            if (D_hit) begin
                $display("✓ Store操作命中");
            end else begin
                $display("✗ Store操作未命中");
                error_count = error_count + 1;
            end
        end
    endtask
    
    // 任务：生成测试指令块
    function [127:0] generate_test_instructions;
        input integer seed;
        begin
            case(seed % 4)
                0: generate_test_instructions = {
                    32'h00000013,  // addi x0, x0, 0
                    32'h00100093,  // addi x1, x0, 1
                    32'h00200113,  // addi x2, x0, 2
                    32'h00300193   // addi x3, x0, 3
                };
                1: generate_test_instructions = {
                    32'b0000000_00000_00000_000_00000_1100011,  // beq x0, x0, 0
                    32'b00000000000000000000_00001_1101111,     // jal x1, 0
                    32'b000000000000_00001_000_00010_1100111,   // jalr x2, x1, 0
                    32'b00000000000000000000_00000_0010111      // auipc x0, 0
                };
                2: generate_test_instructions = {
                    32'hFE010113,  // addi sp, sp, -32
                    32'h00112223,  // sw x1, 4(sp)
                    32'h00212423,  // sw x2, 8(sp)
                    32'h00312623   // sw x3, 12(sp)
                };
                3: generate_test_instructions = {
                    32'h00008067,  // jalr x0, x1, 0
                    32'h0040006F,  // jal x0, 4
                    32'h00000063,  // beq x0, x0, 0
                    32'h00000013   // addi x0, x0, 0
                };
            endcase
        end
    endfunction
    
    // 任务：生成分支指令块
    function [127:0] generate_branch_instructions;
        input integer seed;
        begin
            case(seed % 3)
                0: generate_branch_instructions = {
                    32'b0000000_00001_00010_000_01000_1100011,  // beq x1, x2, 8
                    32'b0000000_00011_00100_001_10000_1100011,  // bne x3, x4, 16
                    32'b0000000_00101_00110_100_11000_1100011,  // blt x5, x6, 24
                    32'b0000000_00111_01000_101_11100_1100011   // bge x7, x8, 28
                };
