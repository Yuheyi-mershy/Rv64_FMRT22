            if (DC_req_monitor) begin
                $display("[%0t] D-Cache总线请求: 地址=%h, 脏=%b, 完成=%b", 
                        $time, DC_addr_monitor, DC_dirty_monitor, DC_done_monitor);
            end
            
            // 监控命中事件
            if (I_hit && IC_dataout_val) begin
                $display("[%0t] 指令命中: VA=%h, 数据=%h, 分支类型=%b", 
                        $time, I_VA, I_data_out, Br_type_out);
            end
            if (D_hit && DC_dataout_val) begin
                $display("[%0t] 数据命中: VA=%h, 数据=%h", 
                        $time, D_VA, D_data_out);
            end
            
            // 监控TLB完成信号
            if (IT_access_done_monitor) begin
                $display("[%0t] I-TLB访问完成（三级页表遍历结束）", $time);
            end
            if (DT_access_done_monitor) begin
                $display("[%0t] D-TLB访问完成（三级页表遍历结束）", $time);
            end
            
            // 监控TLB访问计数器的变化
            if (IT_access_active_monitor) begin
                $display("[%0t] I-TLB访问进行中: 计数器=%b", $time, IT_access_counter_monitor);
            end
            if (DT_access_active_monitor) begin
                $display("[%0t] D-TLB访问进行中: 计数器=%b", $time, DT_access_counter_monitor);
            end
            
            // 监控主存访问
            if (mem_write_en_monitor) begin
                $display("[%0t] 主存写操作: 地址=%h, 数据=%h", 
                        $time, mem_write_addr_monitor, mem_write_data_monitor);
            end
            if (mem_data_valid_monitor) begin
                $display("[%0t] 主存数据有效: 读地址=%h", $time, mem_read_addr_monitor);
            end
        end
    end
    
endmodule
